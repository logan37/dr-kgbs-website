# Copy to .env.local for local builds. In GitHub, set these under
# Settings > Secrets and variables > Actions.

# Access key from https://web3forms.com. Without it, the appointment form
# opens WhatsApp with the request filled in instead of sending an email.
VITE_WEB3FORMS_KEY=

# Public address of the site, no trailing slash. Overrides site.url in src/content/site.ts.
VITE_SITE_URL=

# Folder the site is served from. "/" for a custom domain.
BASE_PATH=/
